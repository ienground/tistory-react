{
  "name": "@ienlab/tistory-react-core",
  "version": "0.1.0-beta.1",
  "description": "Create Tistory Skin with React.js",
  "bugs": "https://github.com/ienground/tistory-react/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/ienground/tistory-react",
    "directory": "packages/cli/core"
  },
  "type": "module",
  "jsnext:source": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "module": "./dist/node/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json",
    "./theme": {
      "default": "./theme.ts"
    },
    "./theme.css": "./theme.css",
    "./runtime": {
      "default": "./runtime.ts"
    }
  },
  "scripts": {
    "dev": "modern build -w",
    "build": "modern build",
    "reset": "rimraf ./**/node_modules",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@rsbuild/core": "^2.1.9",
    "@rsbuild/plugin-react": "^2.1.0",
    "@swc/helpers": "^0.5.23",
    "@ienlab/tistory-react-devtool": "*",
    "@ienlab/tistory-react-runtime": "*",
    "@ienlab/tistory-react-shared": "*",
    "deepmerge": "^4.3.1",
    "enhanced-resolve": "^5.17.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-helmet-async": "^3.0.0",
    "rspack-plugin-virtual-module": "^1.0.1",
    "xml-js": "^1.6.11"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.5.3",
    "vitest": "^2.0.5"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "gitHead": "5955246c00aab7a0e66bc7c7626f8eef2114d96a"
}
