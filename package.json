{
	"name": "@ienlab/tistory-react",
	"private": false,
	"workspaces": [
		"packages/*",
		"examples/*",
		"docs"
	],
	"devDependencies": {
		"@biomejs/biome": "1.8.3",
		"@modern-js/module-tools": "^2.71.1",
		"@modern-js/tsconfig": "^3.7.0",
		"@types/node": "^26.1.2",
		"lerna": "^10.0.0"
	},
	"scripts": {
		"build": "lerna run build",
		"lint": "biome lint . --diagnostic-level=warn",
		"format": "biome format --write ./packages",
		"publish:all": "bash scripts/publish.sh",
		"version:sync": "node scripts/sync-version.js"
	},
	"packageManager": "npm@12.0.2",
	"version": "0.4.2"
}
